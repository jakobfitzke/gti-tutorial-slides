<text layer="pagenumbers_page" matrix="1 0 0 1 13 6.058" transformations="translations" pos="-13 -35" stroke="black" type="label" width="11.7208" height="7.4796" depth="0.115" valign="top" size="veryTiny">{\bf 16}</text>
<text layer="lambda" transformations="translations" pos="16 48" stroke="black" type="minipage" width="576" height="15.469" depth="4.4178" valign="top">$\Rightarrow$ Die Aussage gilt für alle $k\in\mathbb N_0$</text>
</page>
